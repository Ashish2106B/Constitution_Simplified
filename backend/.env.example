# 1. Database Connection URL
# Replace with your local PostgreSQL or cloud Neon / Supabase URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nagrik_samvidhan?schema=public"

# 2. Secret key for signing citizen login JWT tokens
JWT_SECRET="samvidhan_super_secret_jwt_key_2026_xyz"

# 3. Google Gemini API Key (get free from https://aistudio.google.com)
